# Copie este arquivo para .env e preencha as chaves
# NUNCA commite o .env — ele já está no .gitignore

# Chave da API Groq (obtenha em https://console.groq.com — free tier disponível)
GROQ_API_KEY=

# Modelo Groq a usar (padrão: llama-3.1-8b-instant)
GROQ_MODEL=

# Chave da API Tavily (busca web para fallback)
TAVILY_API_KEY=
